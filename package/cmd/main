#!/bin/bash

LOG_FILE="${TRIM_PKGVAR:-/tmp}/info.log"
PACKAGE_BASE="${TRIM_APPDEST:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"

PROJ_NAME="appstore.driver.hwmon.it5570"
MODULE_NAME="it5570_hwmon"
MODULE_FILE="${MODULE_NAME}.ko"
EXPECTED_REVISION="this_pack_driver_revision"
SUPPORTED_KERNEL_VER="6.18.18-trim"

log_msg() {
    local msg="$1"
    local line

    line="$(date '+%Y-%m-%d %H:%M:%S') - ${msg}"
    echo "${line}"
    mkdir -p "$(dirname "${LOG_FILE}")"
    echo "${line}" >> "${LOG_FILE}"
}

report_error() {
    local msg="$1"

    log_msg "${msg}"
    if [[ -n "${TRIM_TEMP_LOGFILE:-}" ]]; then
        mkdir -p "$(dirname "${TRIM_TEMP_LOGFILE}")"
        printf "%s\n" "${msg}" > "${TRIM_TEMP_LOGFILE}"
    fi
}

module_loaded() {
    lsmod | awk '{print $1}' | grep -qx "${MODULE_NAME}"
}

print_recent_dmesg() {
    log_msg "Recent dmesg tail"
    dmesg | tail -n 20 || true
}

kernel_build_num() {
    uname -v | sed -n 's/.*#\([0-9][0-9]*\).*/\1/p' | head -n 1
}

package_module_file() {
    local kernel_ver
    local build_num
    local build_tag
    local arch

    kernel_ver="$(uname -r)"
    build_num="$(kernel_build_num)"

    if [[ "${kernel_ver}" != "${SUPPORTED_KERNEL_VER}" ]]; then
        report_error "Unsupported kernel version: ${kernel_ver}; supported: ${SUPPORTED_KERNEL_VER}"
        return 1
    fi
    if [[ ! "${build_num}" =~ ^[0-9]+$ ]]; then
        report_error "Unsupported kernel build number for ${kernel_ver}: ${build_num}"
        return 1
    fi

    if (( build_num < 570 )); then
        build_tag="427"
    elif (( build_num < 587 )); then
        build_tag="570"
    else
        build_tag="587"
    fi

    case "$(uname -m)" in
    x86_64 | amd64) arch="amd64" ;;
    aarch64 | arm64) arch="arm64" ;;
    *)
        report_error "Unsupported architecture: $(uname -m)"
        return 1
        ;;
    esac

    echo "${PACKAGE_BASE}/app/${PROJ_NAME}_${kernel_ver}-${build_tag}-${arch}/${MODULE_FILE}"
}

verify_module_file() {
    local module_file="$1"
    local revision

    if [[ ! -f "${module_file}" ]]; then
        report_error "Package module not found: ${module_file}"
        return 1
    fi

    revision="$(modinfo -F revision "${module_file}" 2>/dev/null)" || {
        report_error "Unable to read module revision from ${module_file}"
        return 1
    }
    if [[ "${revision}" != "${EXPECTED_REVISION}" ]]; then
        report_error "Unexpected module revision: ${revision}; expected: ${EXPECTED_REVISION}"
        return 1
    fi
}

load_module() {
    local module_file

    if module_loaded; then
        log_msg "${MODULE_NAME} is already loaded"
        return 0
    fi

    module_file="$(package_module_file)" || return 1
    verify_module_file "${module_file}" || return 1

    log_msg "Loading ${MODULE_NAME} from ${module_file}"
    insmod "${module_file}" || {
        report_error "Failed to load ${MODULE_NAME} from ${module_file}"
        print_recent_dmesg
        return 1
    }
    print_recent_dmesg
}

unload_module() {
    if ! module_loaded; then
        return 0
    fi

    log_msg "Unloading ${MODULE_NAME}"
    rmmod "${MODULE_NAME}" || {
        report_error "Failed to unload ${MODULE_NAME}"
        return 1
    }
}

check_status() {
    local module_file

    module_file="$(package_module_file)" || return 1
    verify_module_file "${module_file}" || return 1

    if ! module_loaded; then
        report_error "Package module ${MODULE_NAME} is not loaded"
        return 1
    fi
}

main() {
    case "${1:-}" in
    start)
        uname -a
        log_msg "kernel_info $(uname -r) $(kernel_build_num)"
        load_module
        ;;
    stop)
        unload_module
        ;;
    status)
        check_status || return 3
        ;;
    *)
        report_error "Unsupported command: ${1:-}"
        return 1
        ;;
    esac
}

main "$@"
